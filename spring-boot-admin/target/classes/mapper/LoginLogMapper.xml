<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.LoginLogMapper">

    <resultMap id="loginLogMap" type="LoginLog">
        <id property="id" column="id"/>
        <result property="userName" column="user_name"/>
        <result property="status" column="status"/>
        <result property="ipAddr" column="ip_addr"/>
        <result property="msg" column="msg"/>
        <result property="loginTime" column="login_time"/>
    </resultMap>

    <select id="selectById" resultMap="loginLogMap">
        SELECT * FROM sys_login_log WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="loginLogMap">
        SELECT * FROM sys_login_log
        <where>
            <if test="userName != null and userName != ''">
                AND user_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY login_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_login_log(user_name, status, ip_addr, msg, login_time)
        VALUES(#{userName}, #{status}, #{ipAddr}, #{msg}, #{loginTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM sys_login_log WHERE id = #{id}
    </delete>

    <delete id="deleteAll">
        DELETE FROM sys_login_log
    </delete>

</mapper>
