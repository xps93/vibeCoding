<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.AiConversationMapper">

    <resultMap id="convMap" type="com.example.admin.entity.AiConversation">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="userId" column="user_id"/>
        <result property="modelId" column="model_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="convMap">
        SELECT * FROM ai_conversation WHERE user_id = #{userId} ORDER BY update_time DESC
    </select>

    <select id="selectById" resultMap="convMap">
        SELECT * FROM ai_conversation WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_conversation(title, user_id, model_id, create_time, update_time)
        VALUES(#{title}, #{userId}, #{modelId}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        UPDATE ai_conversation SET title = #{title}, model_id = #{modelId}, update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ai_conversation WHERE id = #{id}
    </delete>

</mapper>
