<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.AiKnowledgeBaseMapper">

    <resultMap id="kbMap" type="com.example.admin.entity.AiKnowledgeBase">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectAll" resultMap="kbMap">
        SELECT * FROM ai_knowledge_base WHERE status = 0 ORDER BY id
    </select>

    <select id="selectById" resultMap="kbMap">
        SELECT * FROM ai_knowledge_base WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_knowledge_base(name, description, status, create_time)
        VALUES(#{name}, #{description}, #{status}, NOW())
    </insert>

    <update id="update">
        UPDATE ai_knowledge_base
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ai_knowledge_base WHERE id = #{id}
    </delete>

</mapper>
