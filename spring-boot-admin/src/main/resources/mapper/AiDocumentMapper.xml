<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.AiDocumentMapper">

    <resultMap id="BaseResultMap" type="com.example.admin.entity.AiDocument">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="content" property="content"/>
        <result column="user_id" property="userId"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.admin.entity.AiDocument" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_document (file_name, file_type, file_size, content, user_id, conversation_id, create_time)
        VALUES (#{fileName}, #{fileType}, #{fileSize}, #{content}, #{userId}, #{conversationId}, #{createTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM ai_document WHERE id = #{id}
    </select>

    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT * FROM ai_document WHERE conversation_id = #{conversationId} ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM ai_document WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <delete id="deleteById">
        DELETE FROM ai_document WHERE id = #{id}
    </delete>

    <delete id="deleteByConversationId">
        DELETE FROM ai_document WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
