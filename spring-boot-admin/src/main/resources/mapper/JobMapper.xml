<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.JobMapper">

    <resultMap id="jobMap" type="Job">
        <id property="id" column="id"/>
        <result property="jobName" column="job_name"/>
        <result property="jobGroup" column="job_group"/>
        <result property="invokeTarget" column="invoke_target"/>
        <result property="cronExpression" column="cron_expression"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectById" resultMap="jobMap">
        SELECT * FROM sys_job WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="jobMap">
        SELECT * FROM sys_job
        <where>
            <if test="keyword != null and keyword != ''">
                AND job_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_job(job_name, job_group, invoke_target, cron_expression, status, create_time)
        VALUES(#{jobName}, #{jobGroup}, #{invokeTarget}, #{cronExpression}, #{status}, #{createTime})
    </insert>

    <update id="update">
        UPDATE sys_job
        SET job_name = #{jobName},
            job_group = #{jobGroup},
            invoke_target = #{invokeTarget},
            cron_expression = #{cronExpression},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_job WHERE id = #{id}
    </delete>

</mapper>
