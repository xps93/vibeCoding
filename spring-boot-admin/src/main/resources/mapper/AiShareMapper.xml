<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.AiShareMapper">

    <resultMap id="shareMap" type="com.example.admin.entity.AiShare">
        <id property="id" column="id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="userId" column="user_id"/>
        <result property="shareToken" column="share_token"/>
        <result property="isActive" column="is_active"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_share(conversation_id, user_id, share_token, is_active, create_time)
        VALUES(#{conversationId}, #{userId}, #{shareToken}, #{isActive}, #{createTime})
    </insert>

    <select id="selectByToken" resultMap="shareMap">
        SELECT * FROM ai_share WHERE share_token = #{shareToken}
    </select>

    <select id="selectByConversationAndUser" resultMap="shareMap">
        SELECT * FROM ai_share WHERE conversation_id = #{conversationId} AND user_id = #{userId} ORDER BY create_time DESC LIMIT 1
    </select>

    <update id="deactivate">
        UPDATE ai_share SET is_active = 0 WHERE id = #{id}
    </update>

</mapper>
